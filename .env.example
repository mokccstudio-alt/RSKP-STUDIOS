# --- Discord ---
DISCORD_TOKEN=
CLIENT_ID=
# Opcional: ID del servidor para registrar los comandos al instante (si se deja vacío, se registran globalmente)
GUILD_ID=

# --- Base de datos (en Railway: ${{Postgres.DATABASE_URL}}) ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/staff_service
# true solo si tu proveedor exige SSL en la conexión (la red interna de Railway no lo necesita)
DATABASE_SSL=false

# --- API para Roblox ---
# Mínimo 32 caracteres. Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ROBLOX_API_KEY=
# Opcional: clave anterior aceptada temporalmente durante una rotación
ROBLOX_API_KEY_PREVIOUS=
PORT=3000

# --- Ajustes de seguimiento (segundos) ---
PRESENCE_GRACE_SECONDS=120
PENDING_TTL_SECONDS=600
LINK_CODE_TTL_SECONDS=600
RECONCILE_INTERVAL_SECONDS=30
MAX_CLOCK_SKEW_SECONDS=300
RATE_LIMIT_PER_MINUTE=1200
